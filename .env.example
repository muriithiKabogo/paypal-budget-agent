# Copy this file to .env and fill it in.

# PayPal SANDBOX app credentials: https://developer.paypal.com/dashboard/applications/sandbox
# The app must have Payouts enabled (Sandbox app settings > Features > Payouts).
# Without these, approved purchases fail at the payment step and no money moves.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# The sandbox Business account the demo vendors get paid into. Find or create one under
# Testing Tools > Sandbox Accounts in the PayPal developer dashboard. Optional: defaults to the
# project author's sandbox vendor account.
VENDOR_PAYPAL_EMAIL=
# Optional, one account per vendor: VENDOR_PAYPAL_EMAIL_ATLASBASE, _QUARRY, _DOCKSIDE, _FASTFACTS

# Gemini API key: https://aistudio.google.com/apikey
# Without it the agent can't plan tasks, and every purchase is denied (it fails closed).
GEMINI_API_KEY=
# "low" (default, ~7s per decision) or "high" (~16s, more thinking).
GEMINI_THINKING_LEVEL=low
# Voice input in browsers without built-in dictation (Brave, Firefox): streamed live to the first,
# with the second transcribing the whole clip if live streaming fails.
GEMINI_LIVE_TRANSCRIBE_MODEL=gemini-3.5-transcribe-live
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-flash

# Optional
PORT=3000
# Shown as "Watch the 2-minute demo" on the landing page when set.
DEMO_VIDEO_URL=
# Only if you run the vendors as their own service (npm run vendors):
# VENDOR_BASE_URL=http://localhost:4000/vendors

# With the guardrails switch off, payouts above this many dollars are recorded but not sent (default 50).
# UNGUARDED_PAYOUT_LIMIT=50
